{
  "name": "clefora-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "preview_urls": false,
  "workers_dev": false,
  "routes": [
    { "pattern": "clefora.fr", "custom_domain": true },
    { "pattern": "www.clefora.fr", "custom_domain": true }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/acheter/*", "/api/*"]
  },
  /* Registre des ventes de leads (Durable Object SQLite, inclus dans l'offre gratuite) */
  "durable_objects": { "bindings": [{ "name": "BOURSE", "class_name": "Bourse" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Bourse"] }]
}
