{
  "name": "clefora-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "preview_urls": false,
  "workers_dev": false,
  "routes": [
    { "pattern": "clefora.fr", "custom_domain": true },
    { "pattern": "www.clefora.fr", "custom_domain": true }
  ],
  "assets": { "directory": "./", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/linkedin/flux.xml"] }
}
